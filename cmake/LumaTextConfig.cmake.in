@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_package(freetype 2.13.3 CONFIG QUIET)
if(NOT TARGET Freetype::Freetype)
  find_dependency(Freetype 2.13.3)
endif()
if(NOT TARGET freetype)
  add_library(freetype INTERFACE IMPORTED)
  set_property(TARGET freetype PROPERTY INTERFACE_LINK_LIBRARIES Freetype::Freetype)
endif()
if(NOT TARGET lumatext_icu_uc)
  add_library(lumatext_icu_uc SHARED IMPORTED)
  set_target_properties(lumatext_icu_uc PROPERTIES
    IMPORTED_IMPLIB "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/icuuc.lib"
    IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/icuuc77.dll")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/LumaTextTargets.cmake")
